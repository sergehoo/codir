# ─── Django ──────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.codir.local

# ─── DB ──────────────────────────────────────────────
DATABASE_URL=postgres://codir:codir@localhost:5432/codir
PG_SSLMODE=prefer

# ─── Cache / Queue ───────────────────────────────────
REDIS_URL=redis://:codir@localhost:6379/0

# ─── Storage S3-compatible (MinIO local OU AWS S3) ───
# MinIO admin (utilisé par le service codirminio + le bucket-init)
MINIO_ROOT_USER=codiradmin
MINIO_ROOT_PASSWORD=ChangeMe-VerySecure-MinIO-2026

# Endpoint S3 interne — utilisé par Django/Celery DANS le réseau Docker.
# - En dev local sans docker compose : http://localhost:9000
# - Dans docker compose : http://codirminio:9000 (service name interne)
S3_ENDPOINT=http://codirminio:9000

# Credentials S3. En self-hosted MinIO : reprendre MINIO_ROOT_USER/PASSWORD.
# En prod AWS : créer un IAM user dédié avec policy minimale sur les 2 buckets.
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# Buckets — créés automatiquement au boot par codirminio_init
S3_BUCKET=codir-dev
RECORDING_S3_BUCKET=codir-recordings-dev
S3_REGION=eu-west-1

# URL publique HTTPS sous laquelle MinIO est exposé (Traefik).
# Utilisée pour générer les URLs présignées renvoyées au navigateur :
# sans ça, le front recevrait des URLs http://codirminio:9000/... inaccessibles
# depuis l'extérieur. Laisser vide en dev local pur (presigned via localhost OK).
S3_PUBLIC_DOMAIN=storage-codir.datarium-dev.com
S3_URL_PROTOCOL=https:
S3_PRESIGN_EXPIRE=3600

# Hosts Traefik des deux endpoints MinIO (S3 API + console admin).
# DNS à configurer pour pointer vers le serveur :
#   storage-codir.datarium-dev.com         → API S3 (URLs présignées audio)
#   codir-minio-console.datarium-dev.com   → Console web admin MinIO
MINIO_S3_HOST=storage-codir.datarium-dev.com
MINIO_CONSOLE_HOST=codir-minio-console.datarium-dev.com

# ─── Search ──────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ─── JWT (clés à générer en prod via openssl) ───────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─── Email — SMTP (exemple Hostinger) ─────────────────
# Pour Hostinger : smtp.hostinger.com / port 587 (TLS) ou 465 (SSL)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=notification@mondomaine.com
EMAIL_HOST_PASSWORD=motdepasse-smtp
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CODIR Executive <notification@mondomaine.com>
SERVER_EMAIL=CODIR Executive <notification@mondomaine.com>

# ─── Frontend / Celery timezone ───────────────────────
FRONTEND_BASE_URL=http://localhost:5173
CELERY_TIMEZONE=Africa/Abidjan

# ─── IA ──────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
AI_DEFAULT_PROVIDER=openai

# ─── Observability ───────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Intégrations ────────────────────────────────────
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
YOUSIGN_API_KEY=
