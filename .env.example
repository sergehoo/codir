# ─── Django ──────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.codir.local

# ─── DB ──────────────────────────────────────────────
DATABASE_URL=postgres://codir:codir@localhost:5432/codir
PG_SSLMODE=prefer

# ─── Cache / Queue ───────────────────────────────────
REDIS_URL=redis://:codir@localhost:6379/0

# ─── Storage S3-compatible ───────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=codir
S3_SECRET_KEY=codirminio
S3_BUCKET=codir-dev
S3_REGION=eu-west-1

# ─── Search ──────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ─── JWT (clés à générer en prod via openssl) ───────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─── Email — SMTP (exemple Hostinger) ─────────────────
# Pour Hostinger : smtp.hostinger.com / port 587 (TLS) ou 465 (SSL)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=notification@mondomaine.com
EMAIL_HOST_PASSWORD=motdepasse-smtp
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CODIR Executive <notification@mondomaine.com>
SERVER_EMAIL=CODIR Executive <notification@mondomaine.com>

# ─── Frontend / Celery timezone ───────────────────────
FRONTEND_BASE_URL=http://localhost:5173
CELERY_TIMEZONE=Africa/Abidjan

# ─── IA ──────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
AI_DEFAULT_PROVIDER=openai

# ─── Observability ───────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Intégrations ────────────────────────────────────
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
YOUSIGN_API_KEY=
