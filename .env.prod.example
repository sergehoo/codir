# ─────────────────────────────────────────────────────────────
# Template d'env PRODUCTION CODIR.
# Copier en .env.prod et remplir. JAMAIS commit le fichier rempli.
#
# Traefik est externe : il tourne déjà sur l'hôte et écoute le réseau
# `proxy` (déclaré external dans docker-compose.prod.yml).
# ─────────────────────────────────────────────────────────────

# ─── Hôtes routés par Traefik externe ────────────────────────
CODIR_HOST=app.codir.example.com
CODIR_API_HOST=api.codir.example.com

# DJANGO_ALLOWED_HOSTS doit contenir :
#  - les domaines publics (API + frontend)
#  - codirweb (nom DNS interne au réseau Docker)
#  - localhost + 127.0.0.1 (utilisés par le healthcheck curl)
DJANGO_ALLOWED_HOSTS=api.codir.example.com,app.codir.example.com,codirweb,localhost,127.0.0.1

# ─── Django ──────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=<openssl rand -hex 32>
DJANGO_DEBUG=False

# ─── DB Postgres ─────────────────────────────────────────────
POSTGRES_DB=codir_prod
POSTGRES_USER=codir_app
POSTGRES_PASSWORD=<openssl rand -base64 32>
PG_SSLMODE=prefer

# ─── Redis / Celery ──────────────────────────────────────────
REDIS_PASSWORD=<openssl rand -base64 32>
CELERY_TIMEZONE=Africa/Abidjan
CELERY_CONCURRENCY=4

# ─── Storage S3 / MinIO ──────────────────────────────────────
# Mode self-hosted MinIO (recommandé pour CODIR prod actuel) :
#   - codirminio embarqué dans docker-compose.prod.yml
#   - Exposé via Traefik avec 2 sous-domaines (cf. plus bas)
#   - Buckets créés automatiquement par codirminio_init au premier boot

# Identifiants MinIO root (générer avec `openssl rand -base64 32`)
MINIO_ROOT_USER=codiradmin
MINIO_ROOT_PASSWORD=<openssl rand -base64 32>

# Endpoint S3 INTERNE — depuis le conteneur Django vers MinIO via réseau Docker.
# Ne JAMAIS mettre l'URL publique HTTPS ici : ça créerait une boucle via Traefik
# pour chaque PUT/GET et coûterait de la latence sans bénéfice.
S3_ENDPOINT=http://codirminio:9000

# Credentials utilisés par Django/Celery pour parler à MinIO.
# En mode self-hosted, on réutilise les root credentials.
# En prod sérieuse : créer un IAM user dédié `codir-app` via la console MinIO,
# attribuer une policy minimale (read+write sur les 2 buckets uniquement),
# et mettre SES credentials ici.
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}

# Buckets — créés au premier boot par codirminio_init via `mc mb`
S3_BUCKET=codir-prod
RECORDING_S3_BUCKET=codir-recordings-prod
S3_REGION=eu-west-1

# URL publique HTTPS de MinIO — utilisée pour générer les URLs présignées
# renvoyées au navigateur (lecture audio, téléchargement docs). Sans ça,
# le front recevrait des URLs http://codirminio:9000/... inaccessibles
# depuis l'extérieur, et l'enregistrement audio des réunions échouerait.
S3_PUBLIC_DOMAIN=storage-codir.datarium-dev.com
S3_URL_PROTOCOL=https:
S3_PRESIGN_EXPIRE=3600

# Hosts Traefik (à pointer en DNS vers le serveur)
MINIO_S3_HOST=storage-codir.datarium-dev.com
MINIO_CONSOLE_HOST=codir-minio-console.datarium-dev.com

# ─── ALTERNATIVE : mode AWS S3 natif (non utilisé actuellement) ──
# Décommenter et désactiver codirminio + codirminio_init dans docker-compose.
# S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
# S3_ACCESS_KEY=<aws_access_key>
# S3_SECRET_KEY=<aws_secret_key>
# S3_SSE=AES256
# (laisser S3_PUBLIC_DOMAIN vide pour utiliser le hostname AWS natif)

# ─── Email SMTP (Hostinger / Mailgun / SES…) ────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=notification@codir.example.com
EMAIL_HOST_PASSWORD=<password smtp>
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CODIR Executive <notification@codir.example.com>
SERVER_EMAIL=CODIR Executive <notification@codir.example.com>

# ─── JWT (RS256 — clés générées via `make jwt-keys`) ────────
# Copier le contenu PEM en remplaçant les \n par \n littéraux :
#   JWT_PRIVATE_KEY="$(cat deploy/keys/jwt-private.pem | sed ':a;N;$!ba;s/\n/\\n/g')"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ─── Observability ───────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── CORS / Frontend ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://app.codir.example.com
FRONTEND_BASE_URL=https://app.codir.example.com
VITE_API_BASE=https://api.codir.example.com/api/v1

# ─── Gunicorn ────────────────────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_THREADS=4

# ─── Docker images (CI/CD) ──────────────────────────────────
CODIR_IMAGE=codir-api:latest
CODIR_WEB_IMAGE=codir-web:latest
