# ─────────────────────────────────────────────────────────────
# Template d'env pour la PRODUCTION CODIR.
# Copier en .env.prod et remplir les valeurs réelles.
# ATTENTION : ne JAMAIS commit ce fichier rempli.
# ─────────────────────────────────────────────────────────────

# ─── Django ──────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=<générer 64+ chars aléatoires, openssl rand -hex 32>
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=app.codir.example.com,api.codir.example.com

# ─── DB Postgres ─────────────────────────────────────────────
POSTGRES_DB=codir_prod
POSTGRES_USER=codir_app
POSTGRES_PASSWORD=<password fort — fait par openssl rand -base64 32>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PG_SSLMODE=require
# OU une URL managée : DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# ─── Redis / Celery ──────────────────────────────────────────
REDIS_PASSWORD=<password fort>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_TIMEZONE=Africa/Abidjan

# ─── Storage S3 (AWS / OVH / Scaleway / Wasabi…) ─────────────
S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
S3_ACCESS_KEY=<aws_access_key>
S3_SECRET_KEY=<aws_secret_key>
S3_BUCKET=codir-prod-storage
S3_REGION=eu-west-3

# ─── Email SMTP (exemple Hostinger) ──────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=notification@codir.example.com
EMAIL_HOST_PASSWORD=<password smtp>
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CODIR Executive <notification@codir.example.com>
SERVER_EMAIL=CODIR Executive <notification@codir.example.com>

# ─── JWT (RS256 — clé entière sur une ligne avec \n) ─────────
# Générer : make jwt-keys
# Puis copier le contenu :
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ─── Observability ───────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── CORS / Frontend ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://app.codir.example.com
FRONTEND_BASE_URL=https://app.codir.example.com

# ─── Frontend build args ─────────────────────────────────────
VITE_API_BASE=https://api.codir.example.com/api/v1

# ─── Docker images (pour CI/CD) ──────────────────────────────
CODIR_IMAGE=codir-api:latest
CODIR_WEB_IMAGE=codir-web:latest
