# ─── Django ──────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-key-change-me-in-production-9c8a7f6e1234
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.codir.local

# ─── DB (PostgreSQL) ─────────────────────────────────
# Pré-requis : créer le user et la base en local :
#   psql postgres
#   CREATE USER codir WITH PASSWORD 'codir';
#   CREATE DATABASE codir OWNER codir;
#   GRANT ALL PRIVILEGES ON DATABASE codir TO codir;
POSTGRES_DB=codir
POSTGRES_USER=postgres
POSTGRES_PASSWORD=weddingLIFE18
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Cache / Queue ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Storage S3-compatible (MinIO) ───────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=codir
S3_SECRET_KEY=codirminio
S3_BUCKET=codir-dev
S3_REGION=eu-west-1

# ─── Search ──────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ─── JWT (HS256 en dev — base.py force RS256 en prod) ─
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─── Email — DEV : MailHog (localhost:1025) ──────────
# Lancer MailHog : docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
# Pour passer en prod Hostinger : voir .env.example
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CODIR Executive <no-reply@codir.local>
SERVER_EMAIL=CODIR Executive <no-reply@codir.local>

# ─── Frontend & Celery TZ ─────────────────────────────
FRONTEND_BASE_URL=http://localhost:5173
CELERY_TIMEZONE=Africa/Abidjan

# ─── IA (vide en bêta) ──────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
AI_DEFAULT_PROVIDER=openai

# ─── Observabilité ──────────────────────────────────
SENTRY_DSN=

# ─── CORS (frontend dev) ─────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
